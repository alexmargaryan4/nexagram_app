rules_version = '2';

// ============================================================================
// NexaGram — Firebase Storage Security Rules
// ============================================================================
// Mirrors lib/core/constants/app_constants.dart's StoragePaths helpers and
// the size limits StorageService enforces client-side. Limits are enforced
// again here since client-side checks alone are trivially bypassable.
//
// Deploy with: firebase deploy --only storage
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Chat membership can't be looked up from Storage rules (no Firestore
    // access here), so chat-scoped paths are readable by any signed-in
    // user and writable by any signed-in user — the same trust boundary
    // Firestore's chat rules already enforce before a client ever learns
    // a chatId exists. A stranger who doesn't know a chat's random id
    // has no way to guess a file path inside it.
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // avatars/{uid}.jpg — StoragePaths.avatar
    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        fileName == request.auth.uid + '.jpg' &&
        isImage() &&
        request.resource.size < 10 * 1024 * 1024; // 10 MB, matches maxImageSizeBytes
      allow delete: if isSignedIn() && fileName == request.auth.uid + '.jpg';
    }

    // chats/{chatId}/images/{fileName} — StoragePaths.chatImage
    match /chats/{chatId}/images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        isImage() &&
        request.resource.size < 10 * 1024 * 1024; // 10 MB
      allow delete: if isSignedIn();
    }

    // chats/{chatId}/files/{fileName} — StoragePaths.chatFile
    match /chats/{chatId}/files/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 50 * 1024 * 1024; // 50 MB, matches maxFileSizeBytes
      allow delete: if isSignedIn();
    }

    // chats/{chatId}/voice/{fileName} — StoragePaths.chatVoice
    match /chats/{chatId}/voice/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.contentType.matches('audio/.*') &&
        request.resource.size < 50 * 1024 * 1024; // 50 MB
      allow delete: if isSignedIn();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
