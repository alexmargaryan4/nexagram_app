rules_version = '2';

// ============================================================================
// NexaGram — Cloud Firestore Security Rules
// ============================================================================
// Mirrors the access patterns in lib/services/*.dart. Whenever a service
// method changes what it reads/writes, update the matching rule here.
//
// Deploy with:  firebase deploy --only firestore:rules
// Test locally: firebase emulators:start --only firestore
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function existingChat() {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in existingChat().participantIds;
    }

    function willBeParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in request.resource.data.participantIds;
    }

    function isGroupAdmin(chatId) {
      return isSignedIn() &&
        request.auth.uid in existingChat().groupAdminIds;
    }

    // True if the incoming write only touches the given field names
    // (used to scope down otherwise-broad update permissions).
    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowed);
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{uid} {
      // Profiles are readable by any signed-in user (search, chat headers,
      // avatars in message lists all need to resolve arbitrary uids).
      allow read: if isSignedIn();

      // Only the owner may create their own profile document, and only as
      // part of the signup flow in AuthService.register (uid must match
      // the newly created Firebase Auth user).
      allow create: if isMe(uid) &&
        request.resource.data.uid == null || isMe(uid);

      // Owner can edit their own profile. Presence fields (isOnline,
      // lastSeen) and fcmTokens are also owner-only, matching
      // UserService.setOnline/setOffline/addFcmToken.
      allow update: if isMe(uid);

      // Profiles are never deleted directly by clients; AuthService
      // .deleteAccount() removes the doc as part of account deletion,
      // which is still "isMe" at the time of the call.
      allow delete: if isMe(uid);

      // users/{uid}/contacts/{contactUid} — private address book.
      // Only the owner can ever read or write their own contact list;
      // this sub-collection is not visible to anyone else, per
      // ContactService's one-directional design.
      match /contacts/{contactUid} {
        allow read, write: if isMe(uid);
      }
    }

    // ------------------------------------------------------------------
    // usernames/{usernameLower} — uniqueness reservation index
    // ------------------------------------------------------------------
    // Written once at signup (AuthService.register, batched with the
    // profile create) and read to check availability before that. Never
    // updated or deleted by clients — a username is permanent once taken.
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // chats/{chatId}
    // ------------------------------------------------------------------
    match /chats/{chatId} {
      // Only current participants can read a chat's metadata.
      allow read: if isParticipant(chatId);

      // Creating a chat (ChatService.getOrCreatePrivateChat /
      // createGroupChat): the creator must be listed as a participant of
      // the chat they're about to create.
      allow create: if willBeParticipant(chatId) &&
        request.resource.data.createdBy == request.auth.uid;

      // Updates cover several distinct client actions; each is scoped to
      // only the fields that action actually touches so no participant
      // can rewrite unrelated data (e.g. silently add themselves as an
      // admin) via a legitimate-looking request.
      allow update: if isParticipant(chatId) && (
        // ChatService.sendMessage: sender updates the "last message"
        // preview and every participant's unread counter.
        onlyChangedFields([
          'lastMessage', 'lastMessageSenderId', 'lastMessageType',
          'lastMessageAt', 'unreadCounts'
        ]) ||
        // togglePin / toggleMute: a participant may only ever add/remove
        // *their own* uid from these two arrays.
        (onlyChangedFields(['pinnedBy']) &&
          request.resource.data.pinnedBy.toSet()
            .difference(resource.data.pinnedBy.toSet())
            .union(resource.data.pinnedBy.toSet()
              .difference(request.resource.data.pinnedBy.toSet()))
            .hasOnly([request.auth.uid])) ||
        (onlyChangedFields(['mutedBy']) &&
          request.resource.data.mutedBy.toSet()
            .difference(resource.data.mutedBy.toSet())
            .union(resource.data.mutedBy.toSet()
              .difference(request.resource.data.mutedBy.toSet()))
            .hasOnly([request.auth.uid])) ||
        // addGroupMember / removeGroupMember / updateGroupInfo: admin-only.
        (resource.data.type == 'group' && isGroupAdmin(chatId) &&
          onlyChangedFields([
            'participantIds', 'unreadCounts', 'groupAdminIds',
            'groupName', 'groupAvatarUrl'
          ]))
      );

      // Deleting the chat doc itself (message sub-collection cleanup is
      // handled server-side — see docs/FIREBASE_SETUP.md).
      allow delete: if isParticipant(chatId);

      // chats/{chatId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        // ChatService.sendMessage: sender must be the authenticated user
        // and a participant of the parent chat.
        allow create: if isParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid;

        // editMessage (sender only, text/editedAt), deleteMessage (sender
        // only, soft-delete flag), markAsDelivered / markChatAsRead
        // (any participant may append their own uid to deliveredTo/
        // readBy), toggleReaction (any participant may add/remove their
        // own uid under any single emoji key).
        allow update: if isParticipant(chatId) && (
          (resource.data.senderId == request.auth.uid &&
            onlyChangedFields(['text', 'editedAt'])) ||
          (resource.data.senderId == request.auth.uid &&
            onlyChangedFields(['isDeleted', 'text', 'mediaUrl'])) ||
          onlyChangedFields(['deliveredTo']) ||
          onlyChangedFields(['readBy']) ||
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['reactions'])
        );

        allow delete: if false; // messages are soft-deleted, never removed
      }

      // chats/{chatId}/typing/{uid} — ephemeral typing indicator.
      match /typing/{uid} {
        allow read: if isParticipant(chatId);
        // A user may only ever write their own typing-status document.
        allow write: if isParticipant(chatId) && isMe(uid);
      }
    }

    // ------------------------------------------------------------------
    // reports/{reportId} — user-submitted abuse reports (write-only from
    // the client; reviewed by moderators via the Firebase console / a
    // separate admin tool, not by this app).
    // ------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
